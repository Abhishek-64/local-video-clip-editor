{
  "name": "local-video-clip-editor-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "deploy": "wrangler deploy -c wrangler.toml",
    "db:migrate": "wrangler d1 migrations apply videoclip-db --remote -c wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply videoclip-db --local -c wrangler.toml",
    "db:execute:local": "wrangler d1 execute videoclip-db --local --file=schema.sql -c wrangler.toml",
    "db:execute:remote": "wrangler d1 execute videoclip-db --remote --file=schema.sql -c wrangler.toml"
  },
  "dependencies": {
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
